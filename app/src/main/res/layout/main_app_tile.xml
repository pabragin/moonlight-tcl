<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the grid: box art in a rounded card (3:4 like Sunshine art), name when there is no art,
     a "Running" badge for the app the PC is streaming now. The card scales up a little when selected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="226dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/tileCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_tile_bg"
        android:clipToOutline="true"
        android:foreground="@drawable/main_tile_ring">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/runningBadge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="@drawable/main_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_running"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
