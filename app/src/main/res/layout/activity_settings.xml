<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (SettingsActivity): categories on the left, the rows of the chosen category on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.limelight.ui.PaneListView
            android:id="@+id/categoryList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="2dp"
            android:listSelector="@android:color/transparent"
            android:nextFocusRight="@+id/itemList"
            android:scrollbars="none" />

        <!-- Only while editing a profile -->
        <LinearLayout
            android:id="@+id/profileActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/saveProfileButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/main_pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/save"
                android:textColor="@color/main_chip_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/renameProfileButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/main_pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/rename"
                android:textColor="@color/main_chip_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <com.limelight.ui.PaneListView
        android:id="@+id/itemList"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="2dp"
        android:fadingEdgeLength="56dp"
        android:listSelector="@android:color/transparent"
        android:nextFocusLeft="@id/categoryList"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none" />
</LinearLayout>
