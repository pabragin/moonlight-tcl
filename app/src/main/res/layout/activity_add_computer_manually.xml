<?xml version="1.0" encoding="utf-8"?>
<!-- Add a PC by address (AddComputerManually): one card in the middle of the screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:background="@drawable/game_menu_bg"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/manuallyAddPcText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_pc"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/main_add_pc_message"
            android:textColor="#FFB8B8BC"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hostTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ip_hint"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions|textUri"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF8E8E93"
                android:textSize="18sp">

                <requestFocus />
            </EditText>

            <TextView
                android:id="@+id/addPcButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/main_pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/main_add_pc"
                android:textColor="@color/main_chip_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
