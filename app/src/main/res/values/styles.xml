<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base theme of every screen outside the stream, on the framework's Material theme: near-black
        background, white text and accents, the dark panel for every dialog. No AppCompat anywhere.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E0E10</item>
        <item name="android:colorBackground">#0E0E10</item>
        <item name="android:colorPrimary">#0E0E10</item>
        <item name="android:colorPrimaryDark">#0E0E10</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:colorControlActivated">#FFFFFFFF</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFB8B8BC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Avoid some systems like MIUI which break the visibility of games title -->
        <item name="android:forceDarkAllowed">false</item>
        <!-- Every dialog and context menu of the app: the compact dark panel of the in-game menu -->
        <item name="android:alertDialogTheme">@style/MoonlightDialogTheme</item>
        <item name="android:dialogTheme">@style/MoonlightDialogTheme</item>
        <item name="android:windowAnimationStyle">@style/ScreenFade</item>
    </style>

    <!-- Screens fade into each other the way the TV's own menus do -->
    <style name="ScreenFade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="MainTheme" parent="AppTheme" />

    <!-- Stream activity theme: black, not transparent, which avoids a see-through window while switching apps -->
    <style name="StreamTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="android:colorButtonNormal">@android:color/white</item>
    </style>

    <!--
        Dialogs, menus and progress spinners (the in-game menu, the PC/app context menus, errors, pairing,
        quit confirmation): a compact dark panel in the gamepad card style, faint dim behind it, small muted
        heading, white text, a soft rounded highlight on the selected row.
    -->
    <style name="MoonlightDialogTheme" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/game_menu_bg</item>
        <!-- A floor for the menus; the ceiling is Dialog.compact() in code (the fixed-width attributes are private) -->
        <item name="android:windowMinWidthMajor">320dp</item>
        <item name="android:windowMinWidthMinor">320dp</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowTitleStyle">@style/MoonlightDialogTitle</item>
        <item name="android:dialogPreferredPadding">20dp</item>
        <item name="android:listDivider">@null</item>
        <item name="android:listDividerAlertDialog">@null</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/game_menu_item_bg</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#DDFFFFFF</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:colorControlActivated">#FFFFFFFF</item>
        <item name="android:colorControlNormal">#99FFFFFF</item>
    </style>

    <style name="MoonlightDialogTitle">
        <item name="android:textAppearance">@style/MoonlightDialogTitleText</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="MoonlightDialogTitleText" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

</resources>
