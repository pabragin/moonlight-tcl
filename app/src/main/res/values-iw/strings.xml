    <string name="nettest_title_waiting">בודק את חיבור הרשת</string>
    <string name="nettest_text_waiting">כעת Artemis בודק את חיבור הרשת כדי לקבוע אם פורטים נדרשים חסומים.\n\nזה עשוי להימשך כמה שניות…</string>
    <string name="nettest_title_done">בדיקת הרשת הושלמה</string>
    <string name="nettest_text_success">נראה שהרשת שלך אינה חוסמת את Artemis. אם עדיין יש בעיות בחיבור, בדוק את הגדרות חומת האש במחשב.\n\nאם אתה מנסה לעשות סטרימינג דרך האינטרנט, התקן את Artemis Internet Hosting Tool במחשב והרץ את Internet Streaming Tester המצורף כדי לבדוק את חיבור האינטרנט של המחשב.</string>
    <string name="nettest_text_inconclusive">לא ניתן היה לבצע את בדיקת הרשת כי אף אחד משרתי הבדיקה של Artemis לא היה זמין. בדוק את חיבור האינטרנט או נסה שוב מאוחר יותר.</string>
    <string name="nettest_text_failure">נראה שחיבור הרשת הנוכחי של המכשיר חוסם את Artemis. סטרימינג דרך האינטרנט עלול לא לעבוד ברשת זו.\n\nהפורטים הבאים חסומים:\n</string>
    <string name="nettest_text_blocked">חיבור הרשת הנוכחי של המכשיר חוסם את Artemis. סטרימינג דרך האינטרנט עלול לא לעבוד ברשת זו.</string>
