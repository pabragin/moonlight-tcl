<?xml version="1.0" encoding="utf-8"?>
<!-- PC chip in the header row: dark pill, lighter when it is the PC on screen, white when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="160">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FF3A3A40" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FF232326" />
        </shape>
    </item>
</selector>
